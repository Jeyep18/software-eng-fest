[sub_resource type="Resource" id="Line_no_hammer_1"]
script = ExtResource("5_line")
speaker_name = "Ate Linda"
text = "Oh, iho, ano ang iyong mga kailangan?"
metadata/_custom_type_script = "uid://po32410sv037"

[sub_resource type="Resource" id="Line_no_hammer_2"]
script = ExtResource("5_line")
speaker_name = "Ate Linda"
text = "Pasensya na at mataas presyo. Kung may martilyo ka sana para dito sa istante, bababaan ko presyo ko sa'yo."
metadata/_custom_type_script = "uid://po32410sv037"

[sub_resource type="Resource" id="Seq_no_hammer"]
