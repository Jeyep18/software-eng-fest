[sub_resource type="Resource" id="Line_trade_1"]
script = ExtResource("5_line")
speaker_name = "Ate Linda"
text = "Iho, kung may martilyo ka sana, maayos ko itong istante. Kapag natulungan mo ako, bababaan ko presyo ko sa'yo."
metadata/_custom_type_script = "uid://po32410sv037"

[sub_resource type="Resource" id="Line_trade_2"]
script = ExtResource("5_line")
speaker_name = "Ate Linda"
text = "Ipapahiram mo? Sige, utang na loob ko 'to. Ibababa ko presyo, pero kailangan mo ng pamalit kung aayusin mo pa bahay n'yo."
metadata/_custom_type_script = "uid://po32410sv037"

[sub_resource type="Resource" id="Seq_trade"]
script = ExtResource("6_seq")
lines = Array[ExtResource("5_line")]([SubResource("Line_trade_1"), SubResource("Line_trade_2")])
metadata/_custom_type_script = "uid://b55uh8miobq8a"

[sub_resource type="Resource" id="Line_discounted"]
script = ExtResource("5_line")
speaker_name = "Ate Linda"
text = "Salamat, iho. Para sa'yo, mas mababa na presyo."
metadata/_custom_type_script = "uid://po32410sv037"

[sub_resource type="Resource" id="Seq_discounted"]
script = ExtResource("6_seq")
