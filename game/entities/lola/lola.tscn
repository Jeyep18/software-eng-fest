metadata/_custom_type_script = "uid://b55uh8miobq8a"

[sub_resource type="Resource" id="Resource_clmbx"]
script = ExtResource("3_dw7mn")
speaker_name = "Nanay"
expression = ExtResource("4_pgefp")
text = "Sabi ni Nanay, wala tayong pagkain para bukas. Kailangan kahit lang de lata."
metadata/_custom_type_script = "uid://po32410sv037"

[sub_resource type="Resource" id="Resource_d5nod"]
