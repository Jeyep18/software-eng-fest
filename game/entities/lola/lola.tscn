[sub_resource type="Resource" id="Resource_adolq"]
script = ExtResource("3_dw7mn")
speaker_name = "Lola"
expression = ExtResource("4_pgefp")
text = "Oy apo, halika. Umupo ka muna sandali. "
metadata/_custom_type_script = "uid://po32410sv037"

[sub_resource type="Resource" id="Resource_f6xjy"]
script = ExtResource("3_dw7mn")
speaker_name = "Lola"
expression = ExtResource("4_pgefp")
text = "Apo yung bagyong paparating mag-ingat ka ha."
metadata/_custom_type_script = "uid://po32410sv037"

[sub_resource type="Resource" id="Resource_q26se"]
script = ExtResource("3_dw7mn")
speaker_name = "Player"
expression = ExtResource("5_t0cy6")
text = "Opo Lola."
metadata/_custom_type_script = "uid://po32410sv037"

[sub_resource type="Resource" id="Resource_8ka6y"]
script = ExtResource("3_dw7mn")
speaker_name = "Lola"
expression = ExtResource("4_pgefp")
text = "Mabuti naman. Pero yung gamot ko huwag mo kalimutan yung sa botika ha. "
metadata/_custom_type_script = "uid://po32410sv037"

[sub_resource type="Resource" id="Resource_ak15h"]
script = ExtResource("3_dw7mn")
speaker_name = "Lola"
expression = ExtResource("4_pgefp")
text = "Pag walang gamot, mahihirapan ako. Pasensya na apo. "
metadata/_custom_type_script = "uid://po32410sv037"

[sub_resource type="Resource" id="Resource_5d8dr"]
script = ExtResource("3_dw7mn")
speaker_name = "Player"
expression = ExtResource("6_tkmwj")
text = "Kailangan ni Lola ang gamot. Kailangan ko pumunta ng botika."
metadata/_custom_type_script = "uid://po32410sv037"

[sub_resource type="Resource" id="Resource_ebi62"]
script = ExtResource("3_dw7mn")
speaker_name = "Lola"
expression = ExtResource("4_pgefp")
text = "Sige na apo, pakilagay nalang sa may drawer sa higaan yung aking gamot. "
metadata/_custom_type_script = "uid://po32410sv037"

[sub_resource type="Resource" id="Resource_qv5jj"]
script = ExtResource("5_dyppw")
lines = Array[ExtResource("3_dw7mn")]([SubResource("Resource_adolq"), SubResource("Resource_f6xjy"), SubResource("Resource_q26se"), SubResource("Resource_8ka6y"), SubResource("Resource_ak15h"), SubResource("Resource_5d8dr"), SubResource("Resource_ebi62")])
metadata/_custom_type_script = "uid://b55uh8miobq8a"

[sub_resource type="Resource" id="Resource_dyppw"]
script = ExtResource("3_dw7mn")
speaker_name = "Lola"
expression = ExtResource("4_pgefp")
text = "Yung gamot, huwag mong kalimutan apo. Mahalaga yun sa akin."
metadata/_custom_type_script = "uid://po32410sv037"

[sub_resource type="Resource" id="Resource_t0cy6"]
script = ExtResource("5_dyppw")
lines = Array[ExtResource("3_dw7mn")]([SubResource("Resource_dyppw")])
metadata/_custom_type_script = "uid://b55uh8miobq8a"

[sub_resource type="Resource" id="Resource_tkmwj"]
script = ExtResource("3_dw7mn")
speaker_name = "Lola"
expression = ExtResource("4_pgefp")
text = "Pag umulan nang malakas at walang panakip sa kisame... basa lahat tayo dito. "
metadata/_custom_type_script = "uid://po32410sv037"

[sub_resource type="Resource" id="Resource_d6pkr"]
script = ExtResource("5_dyppw")
