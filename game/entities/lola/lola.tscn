[sub_resource type="Resource" id="Resource_uqh7n"]
script = ExtResource("3_dw7mn")
speaker_name = "Lola"
expression = ExtResource("4_pgefp")
text = "Mabuti na. Nandito na tayo. Dasal lang tayo ngayon."
metadata/_custom_type_script = "uid://po32410sv037"

