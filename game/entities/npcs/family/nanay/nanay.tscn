[sub_resource type="Resource" id="Resource_wdexl"]
script = ExtResource("3_dclit")
speaker_name = "Nanay"
expression = ExtResource("portrait_nanay_speaking")
text = "Kamusta anak, nabili mo na ba ang mga kailangan?"
metadata/_custom_type_script = "uid://po32410sv037"

[sub_resource type="Resource" id="Resource_6ed0c"]
script = ExtResource("6_tmuxm")
lines = Array[ExtResource("3_dclit")]([SubResource("Resource_wdexl")])
metadata/_custom_type_script = "uid://b55uh8miobq8a"

[sub_resource type="Resource" id="Resource_wklle"]
script = ExtResource("3_dclit")
speaker_name = "Nanay"
expression = ExtResource("portrait_nanay_concerned")
text = "Lumalakas na ang hangin anak, mag-ingat ka."
metadata/_custom_type_script = "uid://po32410sv037"

[sub_resource type="Resource" id="Resource_2gl7e"]
script = ExtResource("6_tmuxm")
lines = Array[ExtResource("3_dclit")]([SubResource("Resource_wklle")])
metadata/_custom_type_script = "uid://b55uh8miobq8a"

[sub_resource type="Resource" id="Resource_ysi4t"]
script = ExtResource("3_dclit")
speaker_name = "Nanay"
expression = ExtResource("portrait_nanay_urgent")
text = "Huwag ka nang lumabas ulit anak. Malapit na ang bagyo, dito ka nalang at para ligtas."
metadata/_custom_type_script = "uid://po32410sv037"

[sub_resource type="Resource" id="Resource_2080c"]
