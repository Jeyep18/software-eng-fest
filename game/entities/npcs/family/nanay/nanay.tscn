[ext_resource type="Texture2D" path="res://game/assets/npc_portraits/stylized/nanay/concerned.png" id="portrait_nanay_concerned"]
[ext_resource type="Texture2D" path="res://game/assets/npc_portraits/stylized/nanay/speaking.png" id="portrait_nanay_speaking"]
[ext_resource type="Texture2D" path="res://game/assets/npc_portraits/stylized/nanay/urgent.png" id="portrait_nanay_urgent"]
[ext_resource type="Texture2D" path="res://game/assets/npc_portraits/stylized/player/determined.png" id="portrait_player_determined"]
[ext_resource type="Texture2D" path="res://game/assets/npc_portraits/stylized/player/speaking.png" id="portrait_player_speaking"]

[sub_resource type="Resource" id="Resource_dclit"]
script = ExtResource("3_dclit")
speaker_name = "Nanay"
expression = ExtResource("portrait_nanay_speaking")
text = "Anak kamusta, Narinig mo na ba yung balita?"
metadata/_custom_type_script = "uid://po32410sv037"

[sub_resource type="Resource" id="Resource_x1yr6"]
script = ExtResource("3_dclit")
speaker_name = "Nanay"
expression = ExtResource("portrait_nanay_concerned")
text = "May paparating na bagyo ulit... kailangan nating maghanda."
metadata/_custom_type_script = "uid://po32410sv037"

[sub_resource type="Resource" id="Resource_tmuxm"]
script = ExtResource("3_dclit")
speaker_name = "Nanay"
expression = ExtResource("portrait_nanay_concerned")
text = "Mas malakas daw ito kaysa dati, kaya kailangan nating maging maingat."
metadata/_custom_type_script = "uid://po32410sv037"

[sub_resource type="Resource" id="Resource_8t3t3"]
script = ExtResource("3_dclit")
speaker_name = "Nanay"
expression = ExtResource("portrait_nanay_speaking")
text = "May kailangan tayong bilhin bago lumakas ang bagyo. Ito ang pera, anak."
metadata/_custom_type_script = "uid://po32410sv037"

[sub_resource type="Resource" id="Resource_gkn0j"]
script = ExtResource("3_dclit")
speaker_name = "Nanay"
expression = ExtResource("portrait_nanay_speaking")
text = "Nasa [b]bodega[/b] ang [b]martilyo[/b], [b]radyo[/b], at [b]flashlight[/b]. Kailangan ng [b]isang baterya bawat isa[/b] ng radyo at flashlight bago ilagay sa [b]istante katabi ni Lola[/b]."
metadata/_custom_type_script = "uid://po32410sv037"

[sub_resource type="Resource" id="Resource_2bejg"]
script = ExtResource("3_dclit")
speaker_name = "Nanay"
expression = ExtResource("portrait_nanay_concerned")
text = "[i]Inabot ni Nanay ang pera para sa mga kailangang bilhin.[/i] Hindi natin maililigtas lahat, anak. Unahin mo ang pinaka-kailangan."
metadata/_custom_type_script = "uid://po32410sv037"

[sub_resource type="Resource" id="Resource_6khh6"]
script = ExtResource("3_dclit")
speaker_name = "Nanay"
expression = ExtResource("portrait_nanay_concerned")
text = "Kasya dapat yan kung maingat ka sa pagbili. Mag-ingat ka ha."
metadata/_custom_type_script = "uid://po32410sv037"

[sub_resource type="Resource" id="Resource_ucdwx"]
script = ExtResource("3_dclit")
speaker_name = "Player"
expression = ExtResource("portrait_player_speaking")
text = "Opo Nay. Hahanapin ko kung ano ang kailangan ihanda."
metadata/_custom_type_script = "uid://po32410sv037"

[sub_resource type="Resource" id="Resource_d6eln"]
script = ExtResource("3_dclit")
speaker_name = "Nanay"
expression = ExtResource("portrait_nanay_concerned")
text = "Pasensya na anak, hindi ko kayang umalis ng bahay dahil wala mag aalaga sa bunso."
metadata/_custom_type_script = "uid://po32410sv037"

[sub_resource type="Resource" id="Resource_dt7x6"]
script = ExtResource("3_dclit")
speaker_name = "Nanay"
expression = ExtResource("portrait_nanay_concerned")
text = "Ikaw lang maaasahan ko anak. Mag-ingat ka ha, bumalik ka agad."
metadata/_custom_type_script = "uid://po32410sv037"

[sub_resource type="Resource" id="Resource_67bnw"]
script = ExtResource("3_dclit")
speaker_name = "Player"
expression = ExtResource("portrait_player_determined")
text = "Ako na po bahala nay."
metadata/_custom_type_script = "uid://po32410sv037"

[sub_resource type="Resource" id="Resource_jfkbs"]
